{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/features/layout,_N_T_/features/predictive/layout,_N_T_/features/predictive/page,_N_T_/features/predictive"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/features/predictive/__PAGE__",
    "/features/predictive",
    "/features",
    "/_index",
    "/_head"
  ]
}